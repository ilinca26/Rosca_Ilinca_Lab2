@page
@model Rosca_Ilinca_Lab2.Pages.BorrowingPages.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Borrowing</h4>
    <hr />
   <dl class="row">
    <dt class="col-sm-2">Member</dt>
    <dd class="col-sm-10">@(Model.Borrowing.Member?.FullName ?? "—")</dd>

    <dt class="col-sm-2">Book</dt>
    <dd class="col-sm-10">@(Model.Borrowing.Book?.Title ?? "—")</dd>

    <dt class="col-sm-2">Author</dt>
    <dd class="col-sm-10">@(Model.Borrowing.Book?.Authors?.FullName ?? "—")</dd>

    <dt class="col-sm-2">Return date</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Borrowing.ReturnDate)</dd>
</dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Borrowing.ID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
