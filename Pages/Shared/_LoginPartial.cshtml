@using Microsoft.AspNetCore.Identity
@using Rosca_Ilinca_Lab2.Data
@inject SignInManager<ApplicationUser> SignInManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link text-dark"
               asp-area="Identity"
               asp-page="/Account/Manage/Index">
                Salut, @User.Identity?.Name!
            </a>
        </li>
        <li class="nav-item">
            <form method="post"
                  asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Content("~/")">
                <button type="submit"
                        class="nav-link btn btn-link text-dark">
                    Deconectare
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark"
               asp-area="Identity"
               asp-page="/Account/Register">
                Înregistrare
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark"
               asp-area="Identity"
               asp-page="/Account/Login">
                Autentificare
            </a>
        </li>
    }
</ul>
