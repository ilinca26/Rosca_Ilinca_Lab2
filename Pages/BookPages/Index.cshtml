
@page "/"
@model Rosca_Ilinca_Lab2.Pages.BookPages.IndexModel

@{
    ViewData["Title"] = "Books";
}

<h1>Books</h1>

<p>
    <a asp-page="./Create" class="btn btn-primary">
        Create New
    </a>
</p>

<!-- Filtrare dupa autor -->
<form method="get" class="mb-3">
    <div class="form-group">
        <label for="SelectedAuthorID">
            Filter by Author
        </label>

        <select asp-for="SelectedAuthorID"
                asp-items="Model.AuthorsList"
                class="form-control">
            <option value="">All Authors</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary mt-2">
        Filter
    </button>

    <a asp-page="./Index"
       class="btn btn-secondary mt-2">
        Reset
    </a>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Book Title</th>
            <th>Author</th>
            <th>Price</th>
            <th>Publishing Date</th>
            <th>Publisher</th>
            <th>BookCategories</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.BookD.Books)
        {
            string selectedRow = "";

            if (item.ID == Model.BookID)
            {
                selectedRow = "table-success";
            }

            <tr class="@selectedRow">
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>

                <td>
                    @if (item.Authors != null)
                    {
                        @($"{item.Authors.FirstName} {item.Authors.LastName}")
                    }
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.PublishingDate)
                </td>

                <td>
                    @if (item.Publisher != null)
                    {
                        @item.Publisher.PublisherName
                    }
                </td>

                <td>
                    @if (item.BookCategories != null)
                    {
                        foreach (var category in item.BookCategories)
                        {
                            if (category.Category != null)
                            {
                                <div>
                                    @category.Category.ID
                                    @category.Category.CategoryName
                                </div>
                            }
                        }
                    }
                </td>

                <td>
                    <a asp-page="./Edit"
                       asp-route-id="@item.ID">Edit</a> |

                    <a asp-page="./Details"
                       asp-route-id="@item.ID">Details</a> |

                    <a asp-page="./Delete"
                       asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
