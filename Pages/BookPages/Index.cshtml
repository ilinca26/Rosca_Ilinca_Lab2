@page "/"
@model Rosca_Ilinca_Lab2.Pages.BookPages.IndexModel

@{
    ViewData["Title"] = "Books";
}

<h1>Books</h1>

<p>
    <a asp-page="./Create" class="btn btn-primary">
        Create New
    </a>
</p>

<form asp-page="./Index" method="get" class="mb-3">
    <div class="form-group mb-3">
        <label for="SearchString">
            Find by Book Title / Author Name:
        </label>

        <input type="text"
               id="SearchString"
               name="searchString"
               value="@Model.CurrentFilter"
               class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label for="SelectedAuthorID">
            Filter by Author
        </label>

        <select asp-for="SelectedAuthorID"
                asp-items="Model.AuthorsList"
                class="form-control">
            <option value="">All Authors</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">
        Search
    </button>

    <a asp-page="./Index" class="btn btn-secondary">
        Back to full List
    </a>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-page="./Index"
                   asp-route-sortOrder="@Model.TitleSort"
                   asp-route-searchString="@Model.CurrentFilter"
                   asp-route-SelectedAuthorID="@Model.SelectedAuthorID">
                    Book Title
                </a>
            </th>

            <th>
                <a asp-page="./Index"
                   asp-route-sortOrder="@Model.AuthorSort"
                   asp-route-searchString="@Model.CurrentFilter"
                   asp-route-SelectedAuthorID="@Model.SelectedAuthorID">
                    Author
                </a>
            </th>

            <th>Price</th>
            <th>Publishing Date</th>
            <th>Publisher</th>
            <th>BookCategories</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.BookD.Books)
        {
            string selectedRow = "";

            if (item.ID == Model.BookID)
            {
                selectedRow = "table-success";
            }

            <tr class="@selectedRow">
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>

                <td>
                    @if (item.Authors != null)
                    {
                        @($"{item.Authors.FirstName} {item.Authors.LastName}")
                    }
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.PublishingDate)
                </td>

                <td>
                    @if (item.Publisher != null)
                    {
                        @item.Publisher.PublisherName
                    }
                </td>

                <td>
                    @if (item.BookCategories != null)
                    {
                        foreach (var category in item.BookCategories)
                        {
                            if (category.Category != null)
                            {
                                <div>
                                    @category.Category.ID
                                    @category.Category.CategoryName
                                </div>
                            }
                        }
                    }
                </td>

                <td>
                    <a asp-page="./Edit"
                       asp-route-id="@item.ID">Edit</a> |

                    <a asp-page="./Details"
                       asp-route-id="@item.ID">Details</a> |

                    <a asp-page="./Delete"
                       asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Book.Count == 0)
{
    <p>Nu au fost găsite cărți pentru filtrele introduse.</p>
}