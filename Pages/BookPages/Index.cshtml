@page
@model Rosca_Ilinca_Lab2.Pages.BookPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<form method="get" class="mb-3">
    <label asp-for="SelectedAuthorID">Autor</label>

    <select asp-for="SelectedAuthorID"
            asp-items="Model.AuthorsList"
            class="form-control">
        <option value="">-- Toți autorii --</option>
    </select>

    <button type="submit" class="btn btn-primary mt-2">
        Filtrează
    </button>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Book[0].Title)
            </th>
            <th>Author</th>
       
            <th>
                @Html.DisplayNameFor(model => model.Book[0].Price)
            </th>
            <th>@Html.DisplayNameFor(model => model.Book[0].PublishingDate)</th>
            <th> @Html.DisplayNameFor(model => model.Book[0].Publisher.PublisherName) </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Book) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            <td>
    @item.Authors?.FirstName @item.Authors?.LastName
</td>
            <td>
                @Html.DisplayFor(model => item.Price)
            </td>
            <td> @Html.DisplayFor(modelItem => item.PublishingDate) </td>
            <td> @Html.DisplayFor(modelItem => item.Publisher.PublisherName) </td>

            <td>
                <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
