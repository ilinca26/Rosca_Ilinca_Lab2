@page
@model Rosca_Ilinca_Lab2.Pages.PublisherPages.EditModel

@{
    ViewData["Title"] = "Edit Publisher";
}

<h1>Edit Publisher</h1>

<h4>Publisher</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <input type="hidden" asp-for="Publisher.ID" />
            <div class="form-group">
                <label asp-for="Publisher.PublisherName" class="control-label"></label>
                <input asp-for="Publisher.PublisherName" class="form-control" />
                <span asp-validation-for="Publisher.PublisherName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" /> |
                <a asp-page="./Index">Back to List</a>
            </div>
        </form>
    </div>
</div>

@await Html.PartialAsync("../Shared/_ValidationScriptsPartial")
