@page
@model Rosca_Ilinca_Lab2.Pages.PublisherPages.DetailsModel

@{
    ViewData["Title"] = "Publisher Details";
}

<h1>Publisher Details</h1>

<div>
    <h4>Publisher</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Publisher.PublisherName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Publisher.PublisherName)
        </dd>
    </dl>
    <h4>Books</h4>
    <ul>
    @foreach(var b in Model.Publisher.Books ?? Enumerable.Empty<Rosca_Ilinca_Lab2.Models.Book>())
    {
        <li>@b.Title</li>
    }
    </ul>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Publisher.ID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
